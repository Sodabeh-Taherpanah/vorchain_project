{
  "name": "@vorchain/parsers",
  "version": "0.0.0",
  "private": true,
  "description": "CSV and XLSX files to validated engine input, with German and English header aliases.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.pure.json && tsc --noEmit -p test",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@vorchain/engine": "workspace:*",
    "papaparse": "~5.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "~4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "^5.0.2",
    "@vorchain/config": "workspace:*",
    "fast-check": "^4.10.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
