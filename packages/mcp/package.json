{
  "name": "@vorchain/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only MCP server that exposes the engine's shortage list and stock projection to AI agents.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "serve": "node bin.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vorchain/engine": "workspace:*",
    "@vorchain/parsers": "workspace:*",
    "@vorchain/sample-data": "workspace:*",
    "zod": "~4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "@vorchain/config": "workspace:*",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
