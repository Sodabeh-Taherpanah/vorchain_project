{
  "name": "@vorchain/sample-data",
  "version": "0.0.0",
  "private": true,
  "description": "Bundled demo datasets (DE and EN) and a seeded scale generator.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./scale": "./src/scale.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p scripts",
    "test": "vitest run --project unit",
    "coverage": "vitest run --project unit --coverage",
    "bench": "vitest run --project bench --reporter=verbose",
    "bench:scale": "node scripts/measure-scale.ts",
    "sync": "node scripts/sync-reference.ts",
    "check": "node scripts/sync-reference.ts --check"
  },
  "dependencies": {
    "@vorchain/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@vorchain/config": "workspace:*",
    "@vorchain/parsers": "workspace:*",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
