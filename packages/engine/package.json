{
  "name": "@vorchain/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Pure, deterministic domain logic: supplier delay statistics, stock projection, exceptions and explanations. No I/O, DOM or Node APIs.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.pure.json && tsc --noEmit -p test",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "^5.0.2",
    "@vorchain/config": "workspace:*",
    "fast-check": "^4.10.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
