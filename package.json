{
  "name": "vorchain",
  "version": "0.8.1",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Vorchain: see the material shortages your ERP does not show.",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "coverage": "turbo run coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lhci": "lhci autorun --config=lighthouserc.json",
    "bench": "pnpm --filter @vorchain/engine bench && pnpm --filter @vorchain/sample-data bench",
    "bench:gate": "pnpm --filter @vorchain/sample-data bench:scale --out \"$PWD/perf/bench-current.json\" && node scripts/bench-gate.mjs perf/bench-current.json",
    "bench:update": "pnpm --filter @vorchain/sample-data bench:scale --out \"$PWD/perf/bench-current.json\" && node scripts/bench-gate.mjs perf/bench-current.json --update",
    "budget:bundle": "node scripts/bundle-size.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "check": "turbo run lint typecheck test",
    "check:all": "prettier --check . && turbo run lint typecheck test build test:e2e",
    "map": "node scripts/update-map.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@lhci/cli": "0.16.0",
    "@vorchain/config": "workspace:*",
    "eslint": "^9.39.5",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
