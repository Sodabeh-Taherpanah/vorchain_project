{
  "extends": "@vorchain/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": { "@/*": ["./src/*"] },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "src",
    "e2e",
    "*.ts",
    ".next/types/**/*.ts",
    "../../packages/parsers/types"
  ],
  "exclude": ["node_modules", ".next/standalone"]
}
