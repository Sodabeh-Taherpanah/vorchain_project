{
  "name": "@vorchain/web",
  "version": "0.0.0",
  "private": true,
  "description": "Vorchain website and in-browser demo (Next.js App Router).",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next typegen && eslint .",
    "typecheck": "next typegen && tsc --noEmit",
