# Copy to .env.local for local development. Keys only; never commit values.
# Real values live in GitHub Environments (preview, production) or the host's env settings.

# Contact form mail transport (P1-25, ADR-0007): brevo | console | memory
MAIL_TRANSPORT=
BREVO_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# Cookieless analytics (P1-26, ADR-0012). Unset = no analytics script.
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Public base URL for canonical URLs, sitemap and OG images (P1-23).
NEXT_PUBLIC_SITE_URL=
