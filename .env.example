# Keys only; never commit values.
# - Local development (`pnpm dev`): copy to apps/web/.env.local.
# - Local container (`docker compose up --build`): copy to .env in the repo root.
# - Server: set the values in Coolify's environment settings (ADR-0006, docs/deploy-hetzner.md).
# Every variable is optional; unset values fall back to the safe defaults noted below.

# Build-time: NEXT_PUBLIC_* values are compiled into the browser JavaScript, so changing them
# needs a rebuild. In Coolify, tick "Build Variable" for these.
# Public base URL for canonical URLs, sitemap and OG images (P1-23). Default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
# Cookieless analytics (P1-26, ADR-0012). Unset = no analytics script.
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Runtime: contact form mail transport (P1-25, ADR-0007): brevo | console | memory.
# Default in docker-compose.yml: console (mails are only logged, nothing is sent).
MAIL_TRANSPORT=
BREVO_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# Runtime: host port for `docker compose` (the container always listens on 3000). Default: 3000
PORT=
